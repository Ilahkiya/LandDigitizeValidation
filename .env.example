# ==============================================================================
# LandAssist — Environment Configuration Template
# Copy this file to '.env' and customize values for your local environment.
# Never commit real secrets or credentials to version control.
# ==============================================================================

# Flask Server Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-production

# SQLite Database Location (defaults to landassist.db in backend folder)
DATABASE_PATH=backend/landassist.db

# Private Document Upload Folder (stored outside frontend web root)
UPLOAD_FOLDER=backend/storage/uploads

# OpenAI API Key for AI-Assisted Agreement Drafting (Optional)
# If empty or not set, LandAssist automatically uses the comprehensive template engine
OPENAI_API_KEY=

# Tesseract OCR Executable Path (Optional)
# Set this if Tesseract is installed outside system PATH (e.g. on Windows)
# Example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
